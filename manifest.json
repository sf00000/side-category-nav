{
  "manifest_version": 3,
  "name": "侧边分类导航",
  "version": "1.0.0",
  "description": "在浏览器右侧边栏固定显示自定义分类的网页收藏，支持分类折叠与缩进配置。",
  "permissions": ["sidePanel", "storage", "bookmarks", "favicon", "tabs"],
  "host_permissions": [
    "https://api.openai.com/",
    "https://api.deepseek.com/",
    "https://api.anthropic.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "action": {
    "default_title": "打开侧边分类导航",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
